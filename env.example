# Скопіюйте цей файл як .env і заповніть
BOT_TOKEN=токен_від_BotFather
# Ваш Telegram ID (бот @userinfobot). Кілька адмінів через кому
ADMIN_IDS=123456789
SHOP_NAME=Барбершоп «Борода»
SHOP_ADDRESS=вул. Прикладна, 1
TZ_NAME=Europe/Kyiv
MORNING_HOUR=9

# Порт сайту (за замовчуванням 8080)
PORT=8080
# Ім'я бота без @ (якщо порожньо, визначиться автоматично)
BOT_USERNAME=
# Потрібно лише якщо сайт лежить на іншому домені, ніж програма
ALLOWED_ORIGIN=

# SMS (необов'язково, платно). 1 = увімкнено
SMS_ENABLED=0
TURBOSMS_TOKEN=
TURBOSMS_SENDER=

# Ключ доступу до адмін-панелі /admin (придумайте складний)
ADMIN_PANEL_TOKEN=
